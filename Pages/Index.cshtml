@page
@model IndexModel
@{
    ViewData["Title"] = "Flappy Foto - Ingenieros Edition";
}

<div class="container-fluid mt-3">
    <h1 class="text-center display-6 mb-1 fw-bold">Flappy Inges UMG</h1>
    <p class="text-center text-muted mb-3 small">Selecciona un ingeniero de la cuadrícula o sube tu propia foto. ¡Presiona <strong>Espacio</strong> para saltar!</p>

    <div class="row g-3 justify-content-center align-items-center">

        <div class="col-12 col-md-4 col-lg-3">
            <div class="card shadow-sm border-2">
                <div class="card-header bg-dark text-white text-center fw-bold py-2 small">
                    Selecciona tu Inge
                </div>
                <div class="card-body bg-light p-2">
                    <div style="max-height: 320px; overflow-y: auto; padding-right: 2px;">
                        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; text-align: center;">

                            <div class="p-1 border bg-white rounded shadow-sm" style="cursor: pointer;" onclick="changeCharacter('/images/personaje1IngeLuis.png')">
                                <img src="/images/personaje1IngeLuis.png" alt="Luis" style="width: 42px; height: 42px; object-fit: cover; border-radius: 50%;" onerror="this.src='https://placehold.co/42'" />
                                <div style="font-size: 10px; font-weight: bold; margin-top: 2px; line-height: 1.1; word-wrap: break-word;">Inge Luis</div>
                            </div>

                            <div class="p-1 border bg-white rounded shadow-sm" style="cursor: pointer;" onclick="changeCharacter('/images/personaje2IngeSara.png')">
                                <img src="/images/personaje2IngeSara.png" alt="Sara" style="width: 42px; height: 42px; object-fit: cover; border-radius: 50%;" onerror="this.src='https://placehold.co/42'" />
                                <div style="font-size: 10px; font-weight: bold; margin-top: 2px; line-height: 1.1; word-wrap: break-word;">Inge Sara</div>
                            </div>

                            <div class="p-1 border bg-white rounded shadow-sm" style="cursor: pointer;" onclick="changeCharacter('/images/personaje3IngeFido.png')">
                                <img src="/images/personaje3IngeFido.png" alt="Fido" style="width: 42px; height: 42px; object-fit: cover; border-radius: 50%;" onerror="this.src='https://placehold.co/42'" />
                                <div style="font-size: 10px; font-weight: bold; margin-top: 2px; line-height: 1.1; word-wrap: break-word;">Inge Fido</div>
                            </div>

                            <div class="p-1 border bg-white rounded shadow-sm" style="cursor: pointer;" onclick="changeCharacter('/images/personaje4IngeCristian.png')">
                                <img src="/images/personaje4IngeCristian.png" alt="Cristian" style="width: 42px; height: 42px; object-fit: cover; border-radius: 50%;" onerror="this.src='https://placehold.co/42'" />
                                <div style="font-size: 10px; font-weight: bold; margin-top: 2px; line-height: 1.1; word-wrap: break-word;">Inge Cristian</div>
                            </div>

                            <div class="p-1 border bg-white rounded shadow-sm" style="cursor: pointer;" onclick="changeCharacter('/images/personaje5IngeDavid.png')">
                                <img src="/images/personaje5IngeDavid.png" alt="David" style="width: 42px; height: 42px; object-fit: cover; border-radius: 50%;" onerror="this.src='https://placehold.co/42'" />
                                <div style="font-size: 10px; font-weight: bold; margin-top: 2px; line-height: 1.1; word-wrap: break-word;">Inge David</div>
                            </div>

                            <div class="p-1 border bg-white rounded shadow-sm" style="cursor: pointer;" onclick="changeCharacter('/images/personaje6IngeFernando.png')">
                                <img src="/images/personaje6IngeFernando.png" alt="Fernando" style="width: 42px; height: 42px; object-fit: cover; border-radius: 50%;" onerror="this.src='https://placehold.co/42'" />
                                <div style="font-size: 10px; font-weight: bold; margin-top: 2px; line-height: 1.1; word-wrap: break-word;">Inge Fer</div>
                            </div>

                            <div class="p-1 border bg-white rounded shadow-sm" style="cursor: pointer;" onclick="changeCharacter('/images/personaje7IngeNestor.png')">
                                <img src="/images/personaje7IngeNestor.png" alt="Nestor" style="width: 42px; height: 42px; object-fit: cover; border-radius: 50%;" onerror="this.src='https://placehold.co/42'" />
                                <div style="font-size: 10px; font-weight: bold; margin-top: 2px; line-height: 1.1; word-wrap: break-word;">Inge Nestor</div>
                            </div>

                            <div class="p-1 border bg-white rounded shadow-sm" style="cursor: pointer;" onclick="changeCharacter('/images/personaje8IngeAgusto.png')">
                                <img src="/images/personaje8IngeAgusto.png" alt="Agusto" style="width: 42px; height: 42px; object-fit: cover; border-radius: 50%;" onerror="this.src='https://placehold.co/42'" />
                                <div style="font-size: 10px; font-weight: bold; margin-top: 2px; line-height: 1.1; word-wrap: break-word;">Inge Agusto</div>
                            </div>

                            <div class="p-1 border bg-white rounded shadow-sm" style="cursor: pointer;" onclick="changeCharacter('/images/personaje9IngeCanahui.png')">
                                <img src="/images/personaje9IngeCanahui.png" alt="Canahui" style="width: 42px; height: 42px; object-fit: cover; border-radius: 50%;" onerror="this.src='https://placehold.co/42'" />
                                <div style="font-size: 10px; font-weight: bold; margin-top: 2px; line-height: 1.1; word-wrap: break-word;">Inge Canahui</div>
                            </div>

                            <div class="p-1 border bg-white rounded shadow-sm" style="cursor: pointer;" onclick="changeCharacter('/images/personaje10IngeElmer.png')">
                                <img src="/images/personaje10IngeElmer.png" alt="Elmer" style="width: 42px; height: 42px; object-fit: cover; border-radius: 50%;" onerror="this.src='https://placehold.co/42'" />
                                <div style="font-size: 10px; font-weight: bold; margin-top: 2px; line-height: 1.1; word-wrap: break-word;">El Maestro</div>
                            </div>

                        </div>
                    </div>

                    <div class="mt-2 pt-2 border-top">
                        <label class="form-label font-monospace card-text text-center d-block mb-1" style="font-size:11px;">¿O prefieres tu propia foto?</label>
                        <input type="file" id="imageInput" accept="image/*" class="form-control form-control-sm" />
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-8 col-lg-8 text-center">
            <canvas id="gameCanvas" width="600" height="400" style="border: 3.5px solid #111; background: #70c5ce; display: block; margin: 0 auto; box-shadow: 0 8px 16px rgba(0,0,0,0.2); border-radius: 10px; width: 100%; max-width: 820px; height: auto;"></canvas>
        </div>

    </div>
</div>

<script>
    const canvas = document.getElementById("gameCanvas");
    const ctx = canvas.getContext("2d");
    const imageInput = document.getElementById("imageInput");

    // Configuración del fondo dinámico en loop
    const background = {
        img: new Image(),
        x: 0,
        speed: 1.2
    };
    background.img.src = '/images/Paralax backround.png';

    // Ajustado para lucir excelente en el escalado visual grande
    let bird = {
        x: 80,
        y: 150,
        width: 52,
        height: 52,
        gravity: 0.35,
        velocity: 0,
        jump: -6.5,
        hitboxWidth: 40,
        hitboxHeight: 40
    };
    let birdImage = null;

    function changeCharacter(url) {
        birdImage = new Image();
        birdImage.src = url;
    }

    imageInput.addEventListener("change", function(e) {
        const file = e.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function(event) {
                birdImage = new Image();
                birdImage.src = event.target.result;
            }
            reader.readAsDataURL(file);
        }
    });

    let pipes = [];
    let score = 0;
    let gameOver = false;
    let gameStarted = false;

    function createPipe() {
        let gap = 140;
        let topHeight = Math.floor(Math.random() * (canvas.height - gap - 100)) + 50;
        pipes.push({ x: canvas.width, top: topHeight, bottom: canvas.height - topHeight - gap, width: 60 });
    }

    // Carga inicial por defecto para que no inicie vacío (Usa el primer ingeniero disponible)
    changeCharacter('/images/personaje1IngeLuis.png');

    function resetGame() {
        bird.y = 150;
        bird.velocity = 0;
        pipes = [];
        score = 0;
        gameOver = false;
        gameStarted = false;
        createPipe();
    }

    function inputAction() {
        if (gameOver) {
            resetGame();
        } else if (!gameStarted) {
            gameStarted = true;
            bird.velocity = bird.jump;
        } else {
            bird.velocity = bird.jump;
        }
    }

    window.addEventListener("keydown", (e) => {
        if(e.code === "Space") {
            inputAction();
            e.preventDefault();
        }
    });
    canvas.addEventListener("click", inputAction);

    function update() {
        if (!gameStarted || gameOver) return;

        background.x -= background.speed;
        if (background.x <= -canvas.width) {
            background.x = 0;
        }

        bird.velocity += bird.gravity;
        bird.y += bird.velocity;

        if (bird.y + bird.height > canvas.height || bird.y < 0) gameOver = true;

        if (pipes[0] && pipes[0].x + pipes[0].width < 0) {
            pipes.shift();
            score++;
        }

        let offsetX = (bird.width - bird.hitboxWidth) / 2;
        let offsetY = (bird.height - bird.hitboxHeight) / 2;

        let birdHitboxX = bird.x + offsetX;
        let birdHitboxY = bird.y + offsetY;

        pipes.forEach(pipe => {
            pipe.x -= 3;

            if (birdHitboxX < pipe.x + pipe.width && birdHitboxX + bird.hitboxWidth > pipe.x &&
                (birdHitboxY < pipe.top || birdHitboxY + bird.hitboxHeight > canvas.height - pipe.bottom)) {
                gameOver = true;
            }
        });

        if (pipes[pipes.length - 1].x < canvas.width - 250) createPipe();
    }

    function draw() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        // 1. Fondo Infinito
        if (background.img.complete) {
            ctx.drawImage(background.img, background.x, 0, canvas.width, canvas.height);
            ctx.drawImage(background.img, background.x + canvas.width, 0, canvas.width, canvas.height);
        } else {
            ctx.fillStyle = "#70c5ce";
            ctx.fillRect(0, 0, canvas.width, canvas.height);
        }

        // 2. Personaje Circular
        ctx.save();
        ctx.beginPath();
        let radius = bird.width / 2;
        ctx.arc(bird.x + radius, bird.y + radius, radius, 0, Math.PI * 2);
        ctx.clip();

        if (birdImage && birdImage.complete) {
            ctx.drawImage(birdImage, bird.x, bird.y, bird.width, bird.height);
        } else {
            ctx.fillStyle = "#ffde22";
            ctx.fillRect(bird.x, bird.y, bird.width, bird.height);
        }
        ctx.restore();

        // 3. Tuberías Redondeadas
        ctx.fillStyle = "#73bf2e";
        pipes.forEach(pipe => {
            ctx.beginPath();
            ctx.roundRect(pipe.x, -20, pipe.width, pipe.top + 20, [0, 0, 12, 12]);
            ctx.fill();

            let bottomY = canvas.height - pipe.bottom;
            ctx.beginPath();
            ctx.roundRect(pipe.x, bottomY, pipe.width, pipe.bottom + 20, [12, 12, 0, 0]);
            ctx.fill();
        });

        // 4. Score
        ctx.fillStyle = "#000";
        ctx.font = "bold 22px Arial";
        ctx.fillText("Score: " + score, 15, 35);

        // Pantalla de Inicio
        if (!gameStarted && !gameOver) {
            ctx.fillStyle = "rgba(0,0,0,0.4)";
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            ctx.fillStyle = "#fff";
            ctx.textAlign = "center";
            ctx.font = "bold 26px Arial";
            ctx.fillText("PRESIONA ESPACIO PARA INICIAR", canvas.width / 2, canvas.height / 2);
            ctx.font = "16px Arial";
            ctx.fillText("O haz clic sobre el recuadro del juego", canvas.width / 2, canvas.height / 2 + 40);
            ctx.textAlign = "left";
        }

        // Pantalla de Game Over
        if (gameOver) {
            ctx.fillStyle = "rgba(0,0,0,0.6)";
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            ctx.fillStyle = "#fff";
            ctx.textAlign = "center";
            ctx.font = "bold 35px Arial";
            ctx.fillText("GAME OVER", canvas.width / 2, canvas.height / 2);
            ctx.font = "18px Arial";
            ctx.fillText("Haz clic o espacio para reiniciar", canvas.width / 2, canvas.height / 2 + 40);
            ctx.textAlign = "left";
        }
    }

    function loop() {
        update();
        draw();
        requestAnimationFrame(loop);
    }

    resetGame();
    loop();
</script>